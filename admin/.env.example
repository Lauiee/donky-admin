# DONKEY API URL (프로덕션 빌드에서 절대 URL로 쏠 때만). 개발에서는 비우고 프록시 사용 권장(CORS 방지)
# 비우면: 개발 → /api + Vite 프록시, 프로덕션 → 같은 오리진 상대 경로
# VITE_API_BASE=https://donkey.ai.kr

# 개발 서버 전용: /api 가 프록시되는 백엔드 (기본 http://localhost:8000). 원격이면 예시처럼
# VITE_API_PROXY_TARGET=https://donkey.ai.kr

# STT 채점(Turing) API — 헤더 X-API-Key. cnt 버전이 기본.
#   cnt   : https://cntt.turing.intcorp.ai   (포트 4314)
#   hippo : https://turing.donkey.ai.kr      (포트 4313)
# 비우면 개발 시 Base는 /turing-api (Vite가 cnt 로 프록시 → vite.config.ts)
# VITE_TURING_API_BASE=https://cntt.turing.intcorp.ai
VITE_TURING_API_KEY=

# 개발 전용: UI만 볼 때 (로그인·API 없이). 프로덕션 빌드에서는 적용 안 됨
# VITE_DEV_PREVIEW=true
# VITE_DEV_PREVIEW_ROLE=admin

# 요청 상세 > "AI 성능 지표" 탭 카드 디자인. 4가지 중 하나(1~4) — 고객이 화면에서
# 바꾸는 옵션이 아니라, 배포 시 고객사별로 고정하는 값. 생략하면 1.
#   1: 하단 미니 영역 스파크라인 (기본)
#   2: 도넛 게이지
#   3: 큰 라인차트 + 날짜 라벨
#   4: 큰 영역차트, 우상단 숫자
# VITE_AI_METRICS_VARIANT=1
